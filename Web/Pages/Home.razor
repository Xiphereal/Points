@page "/"
@using Web.Repositories

<PageTitle>Points</PageTitle>

<h1>The points for this week:</h1>

<p role="status">@repository.Points/@repository.IdealPoints (@Percentage()%)</p>

<button class="btn btn-primary" @onclick="ContributeWith20Points">+20</button>
<button class="btn btn-primary" @onclick="Miss20Points">-20</button>
<button class="btn btn-primary" @onclick="ContributeWithBonus">Bonus!</button>

<br/>

<button class="btn btn-primary" @onclick="ResetPoints">Reset points</button>

@code {
    private InMemoryRepository repository;
    
    protected override void OnInitialized()
    {
        repository = new InMemoryRepository();
    }

    private void ContributeWith20Points()
    {
        repository.ContributeWith(20);
    }

    private void Miss20Points()
    {
        repository.AddIdealPoints(20);
    }

    private void ContributeWithBonus()
    {
        repository.ContributeWith(10);
    }

    private void ResetPoints()
    {
        repository.ResetPoints();
    }

    private decimal Percentage()
    {
        if (repository.IdealPoints == 0)
            return 0;

        var percentageBeforeRounding = (float)repository.Points / repository.IdealPoints * 100;

        return Math.Round((decimal)percentageBeforeRounding, decimals: 2);
    }

}