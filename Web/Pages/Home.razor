@page "/"
@using DTOs
@using Web.Repositories
@inject IJSRuntime JsRuntime

<PageTitle>Points</PageTitle>

<h1>The points for this week:</h1>

<p role="status">@pointsBalancePresentation</p>

<button class="btn btn-primary" @onclick="ContributeWith20Points">+20</button>
<button class="btn btn-primary" @onclick="Miss20Points">-20</button>
<button class="btn btn-primary" @onclick="ContributeWithBonus">Bonus!</button>

<br/>

<button class="btn btn-primary" @onclick="ResetPoints">Reset points</button>

@code {
    private HttpRepository repository;

    private string pointsBalancePresentation;

    protected override async Task OnInitializedAsync()
    {
        var baseUrl = await JsRuntime.InvokeAsync<string>("eval", "window._env_.BASE_URL");
        repository = new HttpRepository(baseUrl);
        pointsBalancePresentation = await PresentPointsBalance();
    }

    private async Task ContributeWith20Points()
    {
        await repository.ContributeWith(20);
        pointsBalancePresentation = await PresentPointsBalance();
    }

    private async Task Miss20Points()
    {
        await repository.AddIdealPoints(20);
        pointsBalancePresentation = await PresentPointsBalance();
    }

    private async Task ContributeWithBonus()
    {
        await repository.ContributeWith(10);
        pointsBalancePresentation = await PresentPointsBalance();
    }

    private async Task ResetPoints()
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", "Do you want to reset the points?"))
            return;

        await repository.ResetPoints();
        pointsBalancePresentation = await PresentPointsBalance();
    }

    private async Task<string> PresentPointsBalance()
    {
        var pointsBalance = await repository.GetPointsBalance();

        return $"{pointsBalance.Points}/{pointsBalance.IdealPoints} ({Percentage(pointsBalance)}%)";
    }

    private static decimal Percentage(PointsBalanceDto pointsBalance)
    {
        if (pointsBalance.IdealPoints == 0)
            return 0;

        var percentageBeforeRounding = (float)pointsBalance.Points! / pointsBalance.IdealPoints! * 100;

        return Math.Round((decimal)percentageBeforeRounding, decimals: 2);
    }
}